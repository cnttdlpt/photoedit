  "narrative": {
    "northStar": "IRO silver print",
    "overview": "Quiet neutral paper surfaces frame the photograph. Restrained green selection and clear Vietnamese labels distinguish controls without competing with the image. The current web implementation uses flat surfaces, thin borders and compact rounded controls.",
    "keyCharacteristics": [
      "The photograph supplies the colour.",
      "Neutral surfaces with restrained green selection.",
      "Clear controls and visible keyboard focus.",
      "Native platform conventions remain native."
    ],
    "rules": [
      {
        "name": "The Photo Colour Rule",
        "body": "Keep interface surfaces neutral so image colour remains easy to judge.",
        "section": "colors"
      },
      {
        "name": "The Readable Label Rule",
        "body": "Use the label role for supporting recipe information; do not inherit smaller legacy microtext as a new standard.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Reuse flat borders and tonal fills for persistent tools; reserve elevation for transient overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic light and dark roles for new tools.",
      "Do retain visible focus, readable labels and reduced-motion support.",
      "Do preserve the whole photo in the stage at each viewport."
    ],
    "donts": [
      "Don't copy legacy gradient text, coloured glows or decorative emoji into new chrome.",
      "Don't turn this web record into a claim that native device layouts have been verified."
