[Unit]
Description=IRO Studio 3.0 Web Darkroom Server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/iro-studio
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5
Environment=PORT=4173
Environment=HOST=0.0.0.0
Environment=NODE_ENV=production

# Giới hạn an toàn tài nguyên
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
